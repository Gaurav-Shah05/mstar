@@ -0,0 +1,73 @@
+"""The plain-PNG shortcut in the image header check answers as Pillow does."""
+import numpy as np
+import pytest
+from PIL import Image, PngImagePlugin
+
+from mstar.model import media_limits
+from mstar.model.media_limits import IMAGE_FORMATS, _check_image_header, _plain_rgb_png_size
+
+
+def _pillow_answer(path):
+    with Image.open(path, formats=IMAGE_FORMATS) as image:
+        return (image.format, bool(getattr(image, "is_animated", False)), image.mode, bool(image.has_transparency_data))
+
+
+def _save(path, mode, **kwargs):
+    shape = {"RGB": (12, 16, 3), "RGBA": (12, 16, 4), "L": (12, 16), "P": (12, 16)}[mode]
+    data = np.arange(np.prod(shape), dtype=np.uint8).reshape(shape) % 200
+    Image.fromarray(data).convert(mode).save(path, format="PNG", **kwargs)
+    return str(path)
+
+
+def test_plain_rgb_takes_the_shortcut_and_matches_pillow(tmp_path):
+    path = _save(tmp_path / "a.png", "RGB")
+    assert _plain_rgb_png_size(path) == (16, 12)
+    assert _check_image_header(path, IMAGE_FORMATS) == _pillow_answer(path)
+
+
+def test_text_chunk_keeps_the_shortcut(tmp_path):
+    info = PngImagePlugin.PngInfo()
+    info.add_text("camera", "wrist")
+    path = _save(tmp_path / "a.png", "RGB", pnginfo=info)
+    assert _plain_rgb_png_size(path) == (16, 12)
+
+
+@pytest.mark.parametrize(
+    ("mode", "kwargs"),
+    [("RGBA", {}), ("L", {}), ("P", {}), ("RGB", {"transparency": (1, 2, 3)}), ("RGB", {"icc_profile": b"\0" * 128})],
+)
+def test_anything_else_goes_through_pillow(tmp_path, mode, kwargs):
+    path = _save(tmp_path / "a.png", mode, **kwargs)
+    assert _plain_rgb_png_size(path) is None
+    assert _check_image_header(path, IMAGE_FORMATS) == _pillow_answer(path)
+
+
+def test_animated_png_goes_through_pillow(tmp_path):
+    frames = [Image.new("RGB", (8, 8), (i, 0, 0)) for i in (0, 90)]
+    path = str(tmp_path / "a.png")
+    frames[0].save(path, format="PNG", save_all=True, append_images=frames[1:])
+    assert _plain_rgb_png_size(path) is None
+    assert _check_image_header(path, IMAGE_FORMATS)[1] is True
+
+
+def test_corrupt_ihdr_is_refused_as_before(tmp_path):
+    path = _save(tmp_path / "a.png", "RGB")
+    data = bytearray(open(path, "rb").read())
+    data[17] ^= 0xFF  # width, leaving the CRC wrong
+    open(path, "wb").write(data)
+    assert _plain_rgb_png_size(path) is None
+    with pytest.raises(ValueError, match="not in a format"):
+        _check_image_header(path, IMAGE_FORMATS)
+
+
+def test_format_list_without_png_refuses_a_png(tmp_path):
+    path = _save(tmp_path / "a.png", "RGB")
+    with pytest.raises(ValueError, match="not in a format"):
+        _check_image_header(path, ("JPEG",))
+
+
+def test_size_limit_applies_on_the_shortcut(tmp_path, monkeypatch):
+    path = _save(tmp_path / "a.png", "RGB")
+    monkeypatch.setattr(media_limits, "max_image_pixels", lambda: 100)
+    with pytest.raises(ValueError, match="the limit is 100 pixels"):
+        _check_image_header(path, IMAGE_FORMATS)

+# Chunks that can sit before a PNG's image data without changing what Pillow
+# reports for it. Any other chunk (tRNS, acTL, ...) goes through Pillow.
+_PLAIN_PNG_CHUNKS = frozenset({b"sRGB", b"gAMA", b"cHRM", b"pHYs", b"tIME", b"tEXt", b"zTXt", b"iTXt"})
+
+
+def _plain_rgb_png_size(filepath: str) -> tuple[int, int] | None:
+    """Width and height of an ordinary 8-bit RGB PNG, read straight from its
+    header. ``None`` for anything else, including any malformed file, which is
+    left for Pillow to judge. ``Image.open`` costs about 0.4 ms with the GIL
+    held, which a request's camera frames would pay in series even when their
+    decodes overlap."""
+    with open(filepath, "rb") as f:
+        head = f.read(4096)
+    if head[:16] != b"\x89PNG\r\n\x1a\n\x00\x00\x00\x0dIHDR" or len(head) < 41:
+        return None
+    width, height, depth, color, compression, filtering, interlace, crc = struct.unpack(">IIBBBBBI", head[16:33])
+    if (depth, color, compression, filtering, interlace) != (8, 2, 0, 0, 0) or zlib.crc32(head[12:29]) != crc:
+        return None
+    offset = 33
+    while offset + 8 <= len(head):
+        length, kind = struct.unpack(">I4s", head[offset:offset + 8])
+        if kind == b"IDAT":
+            return width, height
+        if kind not in _PLAIN_PNG_CHUNKS:
+            return None
+        offset += length + 12
+    return None
+

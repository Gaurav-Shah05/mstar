+def test_pi05_deployments_pin_fa2_for_the_action_expert_only(config_name):
+    """Both attentions default to FlashInfer's "auto" kernel; the pi05
+    deployments pin FA2 for the action expert's and leave prefill's on auto."""
     import yaml
 
     from mstar.engine.resources import AttentionSpec
     from mstar.engine.resources.spec import apply_yaml_overrides
+    from mstar.model.pi05.config import LLM_ACTION_ATTN, LLM_ATTN
 
     specs = _make_model().get_node_resources()
-    attn = next(spec for spec in specs if isinstance(spec, AttentionSpec))
-    assert attn.config.flashinfer_backend == "auto"
+    attn = {spec.resource_key: spec for spec in specs if isinstance(spec, AttentionSpec)}
+    assert set(attn) == {LLM_ATTN, LLM_ACTION_ATTN}
+    assert all(spec.config.flashinfer_backend == "auto" for spec in attn.values())
     apply_yaml_overrides(specs, yaml.safe_load((Path(CONFIG_PATH).parent / config_name).read_text()))
-    assert attn.config.flashinfer_backend == "fa2"
+    assert attn[LLM_ACTION_ATTN].config.flashinfer_backend == "fa2"
+    assert attn[LLM_ATTN].config.flashinfer_backend == "auto"
+
+
+def test_pi05_walks_declare_their_own_attention():
+    """prefill plans PaliGemma's attention and action_gen the action expert's."""
+    from mstar.model.pi05.config import LLM_ACTION_ATTN, LLM_ATTN
+    from mstar.model.pi05.submodules import Pi05LLMSubmodule
+    from mstar.model.submodule_base import ARNodeInputs
+
+    llm = Pi05LLMSubmodule(None, None, None, None, None, None, Pi05Config())
+    prefill = llm.declare_step("prefill", ["r"], [ARNodeInputs(input_seq_len=900)])
+    action = llm.declare_step("action_gen", ["r"], [ARNodeInputs(input_seq_len=15)])
+    assert LLM_ATTN in prefill and LLM_ACTION_ATTN not in prefill
+    assert LLM_ACTION_ATTN in action and LLM_ATTN not in action
 
 

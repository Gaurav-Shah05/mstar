+    def _prefill_token_buckets(self) -> list[int]:
+        """One and two requests' longest prefixes, so prefill pads as little as
+        it can at the batch sizes it runs most. Longer steps run eagerly at their
+        exact length, which measured faster than a graph this large, padded."""
+        cfg = self.config
+        longest = cfg.num_cameras * cfg.tokens_per_image + cfg.max_lang_tokens
+        return sorted({512, longest, 2 * longest})
